# ─── Server ───
PORT=5000

# ─── MongoDB ───
# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/bhavprita
# Local MongoDB: mongodb://localhost:27017/bhavprita
MONGO_URI=mongodb://localhost:27017/bhavprita

# ─── Admin Dashboard ───
ADMIN_PASSWORD=admin123

# ─── Email Notifications (SMTP) ───
# Leave blank to disable email notifications
# Gmail: smtp.gmail.com / 587 / your-email@gmail.com / app-password
# Outlook: smtp.office365.com / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email address that receives form notifications
NOTIFY_EMAIL=info@bhavpritasevasamiti.org
